    {
      "name": "A service request from start to finish (run in order)",
      "item": [
        {
          "name": "1. Report a fault (creates a record)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": {{eqId}},\n  \"faultDescription\": \"Postman test fault\",\n  \"priority\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs Equipment list to have run, for a real machine. Priority: 10 Low, 20 Medium, 30 High, 40 Critical. Creates a real service request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"gives a number\", () => pm.expect(j.number).to.match(/^WO-/));",
                  "pm.environment.set(\"woId\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Take it: In progress (becomes yours)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pressing In progress on a fault nobody has takes it. Status: 10 Reported, 20 Assigned, 30 In progress, 40 On hold, 50 Resolved, 60 Closed, 70 Cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Add a note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/notes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Checked by Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. The service request now",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"is in progress\", () => pm.expect(d.status).to.eql(30));",
                  "pm.test(\"is assigned to someone (the person who took it)\", () => pm.expect(d.assignedToUserId).to.be.a(\"number\"));",
                  "pm.test(\"has the note\", () => pm.expect(d.notes.map(n => n.body)).to.include(\"Checked by Postman\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Resolve it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"Replaced the board (Postman test)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is resolved\", () => pm.expect(pm.response.json().status).to.eql(50));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Resolve it again (409, already done)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"again\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Close it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Reopen a closed one (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/work-orders/{{woId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Service report PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reports/work-orders/{{woId}}/report.pdf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is a PDF\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"pdf\"));"
                ]
              }
            }
          ]
        }
      ]
    },

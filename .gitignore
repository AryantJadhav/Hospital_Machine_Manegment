# ---------- Logs ----------
*.log
logs/

# SPA build output — vite writes the React bundle here so it ships inside
# the single binary. Generated, never committed.
# Entirely generated by `npm run build` in web/. Not tracked at all: vite
# runs with emptyOutDir so stale assets never accumulate, which means it
# also deletes any placeholder file kept here. Keeping the directory in git
# would just produce a phantom deletion on every web build.
src/HospitalPm.Api/wwwroot/

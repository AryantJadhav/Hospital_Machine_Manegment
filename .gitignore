# ---------- Secrets & local config ----------
# Never commit real connection strings, JWT signing keys, or licence
# private keys. appsettings.json (non-secret defaults) IS committed.
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
.env
.env.*
!.env.example
secrets.json
*.pfx
*.snk
*.pem
*.key

# Licence signing — the private key must never enter the repo.
licence-private*.*
license-private*.*


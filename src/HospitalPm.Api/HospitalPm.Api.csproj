<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HospitalPm.Infrastructure\HospitalPm.Infrastructure.csproj" />
    <ProjectReference Include="..\HospitalPm.Domain\HospitalPm.Domain.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <AssemblyName>hospitalpm</AssemblyName>
    <RootNamespace>HospitalPm.Api</RootNamespace>

    <!--
      Packaging constraint: one self-contained binary per platform, no .NET
      runtime installed on the hospital's machine.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Do NOT enable PublishTrimmed. EF Core, Hangfire, and System.Text.Json
      resolve types by reflection; the trimmer removes them and the failure
      appears at runtime on the hospital's machine, not in CI.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Runs as a Windows Service, not under IIS. No web.config needed. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>


  <ItemGroup>
    <!--
      Development config must never ship inside the artifact a hospital
      installs. It is gitignored, but the SDK copies it on publish by default.
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

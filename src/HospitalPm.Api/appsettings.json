{
  "Features": {
    "Import": false,
    "Export": false,
    "Backups": false,
    "Updates": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backup": {
    "Directory": "backups",
    "RetainCount": 14,
    "TimeoutMinutes": 30,
    "VerifyAfterWrite": true,
    "PgDumpPath": "",
    "PgRestorePath": ""
  },
  "Licence": {
    "PublicKey": "",
    "Path": "hospitalpm.licence"
  },
  "Update": {
    "PublicKey": "",
    "Directory": "updates",
    "StagingDirectory": "updates/staging",
    "BackupFirst": true,
    "FeedUrl": ""
  },
  "Mdns": {
    "Enabled": true,
    "Hostname": "hospitalpm"
  }
}
